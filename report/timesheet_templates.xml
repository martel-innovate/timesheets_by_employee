<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_timesheets">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 class="text-center mb-4">Timesheet Report by Employees</h2>
                    
                    <!-- Header Information -->
                    <div class="row mb-4">
                        <div class="col-6">
                            <strong>Employee Name</strong>
                            <p t-field="employee.name"/>
                        </div>
                        <div class="col-6">
                            <strong>Timesheet Period</strong>
                            <p t-esc="period"/>
                        </div>
                    </div>
                    
                    <div class="row mb-4">
                        <div class="col-12">
                            <strong>Total Working Hours</strong>
                            <p t-esc="timesheet_data['total']"/>
                        </div>
                    </div>

                    <!-- Project Groups -->
                    <t t-foreach="timesheet_data['projects']" t-as="project">
                        <div class="project-section mb-4">
                            <h4 t-esc="project" class="bg-light p-2"/>
                            
                            <!-- Tasks within Project -->
                            <t t-foreach="timesheet_data['projects'][project]['tasks']" t-as="task">
                                <div class="task-section mt-3">
                                    <h5 class="text-primary" t-esc="task"/>
                                    
                                    <!-- Entries Table -->
                                    <table class="table table-sm table-hover">
                                        <thead>
                                            <tr>
                                                <th>Date</th>
                                                <th>Description</th>
                                                <th class="text-right">Worked Time</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="timesheet_data['projects'][project]['tasks'][task]['entries']" t-as="entry">
                                                <tr>
                                                    <td><span t-esc="entry['date']" t-options="{'widget': 'date'}"/></td>
                                                    <td><span t-esc="entry['description']"/></td>
                                                    <td class="text-right"><span t-esc="entry['duration']"/></td>
                                                </tr>
                                            </t>
                                            <!-- Task Total -->
                                            <tr class="table-light">
                                                <td colspan="2" class="text-right">
                                                    <strong>Task Total:</strong>
                                                </td>
                                                <td class="text-right">
                                                    <strong t-esc="timesheet_data['projects'][project]['tasks'][task]['subtotal']"/>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </t>
                            
                            <!-- Project Total -->
                            <div class="text-right mb-3 bg-light p-2">
                                <strong>Project Total: </strong>
                                <span t-esc="timesheet_data['projects'][project]['subtotal']"/>
                            </div>
                        </div>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
